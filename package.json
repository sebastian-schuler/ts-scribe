{
  "name": "ts-scribe",
  "version": "1.2.1",
  "description": "A collection of utility functions and types for TypeScript projects in Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:esm",
    "build:clean": "rm -rf dist",
    "build:esm": "tsc --project tsconfig.esm.json",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-schuler/ts-scribe.git"
  },
  "keywords": [
    "typescript",
    "node",
    "utility",
    "utils",
    "functions",
    "types"
  ],
  "author": "Sebastian Schuler <contact@sebastian-schuler.com> (https://www.sebastian-schuler.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sebastian-schuler/ts-scribe/issues"
  },
  "homepage": "https://sebastian-schuler.github.io/ts-scribe/",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "bun-types": "latest",
    "semantic-release": "^25.0.3",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "xo": "^2.0.2"
  }
}